{
  "name": "shipreport",
  "version": "0.2.0",
  "description": "Quarterly engineering success story generator — point it at a GitHub org, pick a quarter, get draft success stories per developer plus a team highlight reel.",
  "type": "module",
  "bin": {
    "shipreport": "bin/shipreport.js"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "files": [
    "bin",
    "dist",
    "src/templates",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "dev": "tsx src/cli-main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.2.0",
    "@octokit/graphql": "^9.0.3",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "citty": "^0.2.2",
    "eta": "^3.5.0",
    "markdown-it": "^14.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "fast-check": "^4.8.0",
    "nock": "^14.0.13",
    "prettier": "^3.9.4",
    "puppeteer": "^23.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.1.12",
    "vitest": "^4.1.9"
  },
  "license": "MIT"
}
