# Refuse to install on a runtime that doesn't satisfy package.json's
# `engines` constraint. `node:sqlite` is unflagged starting in Node
# 22.13 (also 23.4); below that, the SQLite-backed paths fail at import
# time with an unhelpful message. Better to fail fast at install.
engine-strict=true

# Use exact pnpm 10.x; pnpm/action-setup pins to 10 in CI but local
# devs running `pnpm i` should get the same major.
package-manager-strict=false
